# Copy to .env and fill in values. Never commit .env.
# On the server, .env is generated by the deploy workflow from GitHub
# Secrets/Variables (Settings -> Secrets and variables -> Actions).

# --- OpenRouter (GitHub SECRET: OPENROUTER_API_KEY) ---
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=your-openrouter-api-key-here
DEFAULT_MODEL=inclusionai/ling-3.0-flash
EMBEDDING_MODEL=openai/text-embedding-3-small

# --- RAG / ChromaDB ---
CHROMA_PERSIST_PATH=./chroma
RAG_COLLECTION_NAME=resume_chunks
RAG_TOP_K=2
RAG_SEARCH_RATE_LIMIT=30/minute

# --- Sessions / Redis (GitHub SECRET: REDIS_PASSWORD) ---
SESSION_TTL_SECONDS=900
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=change-me

# --- CORS (GitHub VARIABLE: CORS_ORIGINS) ---
# Comma-separated frontend origins; scheme + host only, no trailing slash.
# Cross-site frontends (Vercel/GitHub Pages) also require SESSION_COOKIE_SECURE=true + TLS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Cookie security (GitHub VARIABLE: SESSION_COOKIE_SECURE) ---
# true => Secure + SameSite=None (required for cross-site frontend; needs HTTPS).
# false => SameSite=Strict (local/plain-HTTP use).
SESSION_COOKIE_SECURE=false

# --- TLS via Caddy (GitHub VARIABLES: API_HOSTNAME, COMPOSE_PROFILES) ---
# Public hostname with a DNS A record pointing at the server, e.g. api.example.com
API_HOSTNAME=
# Set to "tls" to start the caddy service (also removes need for port 8000 exposure).
COMPOSE_PROFILES=
