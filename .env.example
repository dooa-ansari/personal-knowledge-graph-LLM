# Copy to .env and fill in values. Never commit .env.
#
# Production runs on Railway: the variables below are set in the Railway
# service dashboard (Settings -> Variables), not from this file. This template
# documents every variable the app understands.

# --- OpenRouter (Railway variable, mark as secret) ---
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=your-openrouter-api-key-here
DEFAULT_MODEL=inclusionai/ling-3.0-flash
EMBEDDING_MODEL=openai/text-embedding-3-small

# --- RAG / ChromaDB ---
CHROMA_PERSIST_PATH=./chroma
RAG_COLLECTION_NAME=resume_chunks
RAG_TOP_K=2
RAG_SEARCH_RATE_LIMIT=30/minute
# Entrypoint rebuilds the index on container start; set false to skip.
REINDEX_ON_START=true

# --- Sessions / Redis ---
SESSION_TTL_SECONDS=900
# On Railway, set via service connection: ${{Redis.RAILWAY_REDIS_FULL_INTERNAL_URL}}
REDIS_URL=redis://localhost:6379/0

# --- CORS / Cookies (Railway variables) ---
# Comma-separated frontend origins; scheme + host only, no trailing slash.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# true => Secure + SameSite=None (required for a cross-site frontend like
# Vercel/GitHub Pages; Railway's domain is HTTPS, so use true in production).
SESSION_COOKIE_SECURE=false

# --- Local Docker Compose only (not used by Railway) ---
# Used by docker-compose.yml for Redis auth.
REDIS_PASSWORD=change-me
# With COMPOSE_PROFILES=tls, starts the local Caddy HTTPS proxy for API_HOSTNAME.
API_HOSTNAME=
COMPOSE_PROFILES=

# --- Port (injected automatically by Railway; Dockerfile defaults to 8000) ---
PORT=8000
